object frmMain: TfrmMain
  Left = 200
  Height = 650
  Top = 100
  Width = 1050
  Caption = 'Ace File Search'
  ClientHeight = 650
  ClientWidth = 1050
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  Position = poScreenCenter
  LCLVersion = '3.6.0.0'
  object pnlTop: TPanel
    Left = 0
    Height = 70
    Top = 0
    Width = 1050
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 70
    ClientWidth = 1050
    TabOrder = 0
    object lblPattern: TLabel
      Left = 12
      Height = 15
      Top = 8
      Width = 85
      Caption = 'Search Pattern:'
    end
    object edtPattern: TEdit
      Left = 12
      Height = 23
      Top = 28
      Width = 280
      TabOrder = 0
      Text = '*.png'
    end
    object lblSearchIn: TLabel
      Left = 308
      Height = 15
      Top = 8
      Width = 56
      Caption = 'Search in:'
    end
    object edtSearchPath: TEdit
      Left = 308
      Height = 23
      Top = 28
      Width = 280
      ReadOnly = True
      TabOrder = 1
      Text = 'C:\'
    end
    object cbSubfolders: TCheckBox
      Left = 604
      Height = 19
      Top = 8
      Width = 113
      Caption = 'Include Subfolders'
      Checked = True
      State = cbChecked
      TabOrder = 2
    end
    object cbCaseSensitive: TCheckBox
      Left = 604
      Height = 19
      Top = 32
      Width = 97
      Caption = 'Case Sensitive'
      TabOrder = 3
    end
    object btnSearch: TButton
      Left = 740
      Height = 30
      Top = 20
      Width = 90
      Caption = 'Search'
      Default = True
      TabOrder = 4
      OnClick = btnSearchClick
    end
    object btnStop: TButton
      Left = 838
      Height = 30
      Top = 20
      Width = 75
      Caption = 'Stop'
      Enabled = False
      TabOrder = 5
      OnClick = btnStopClick
    end
    object btnClear: TButton
      Left = 920
      Height = 30
      Top = 20
      Width = 75
      Caption = 'Clear'
      TabOrder = 6
      OnClick = btnClearClick
    end
  end
  object pnlLeft: TPanel
    Left = 0
    Height = 555
    Top = 70
    Width = 280
    Align = alLeft
    BevelOuter = bvNone
    ClientHeight = 555
    ClientWidth = 280
    TabOrder = 1
    object lblFolders: TLabel
      Left = 0
      Height = 20
      Top = 0
      Width = 280
      Align = alTop
      Alignment = taCenter
      Caption = 'Select Start Folder'
      Layout = tlCenter
    end
    object ShellTreeView1: TShellTreeView
      Left = 0
      Height = 535
      Top = 20
      Width = 280
      Align = alClient
      FileSortType = fstFoldersFirst
      ObjectTypes = [otFolders]
      TabOrder = 0
      OnSelectionChanged = ShellTreeView1SelectionChanged
      Options = [tvoAutoItemHeight, tvoHideSelection, tvoKeepCollapsedNodes, tvoReadOnly, tvoShowButtons, tvoShowLines, tvoShowRoot, tvoToolTips, tvoThemedDraw]
    end
  end
  object splMain: TSplitter
    Left = 280
    Height = 555
    Top = 70
    Width = 5
  end
  object pnlRight: TPanel
    Left = 285
    Height = 555
    Top = 70
    Width = 765
    Align = alClient
    BevelOuter = bvNone
    ClientHeight = 555
    ClientWidth = 765
    TabOrder = 3
    object lvResults: TListView
      Left = 0
      Height = 555
      Top = 0
      Width = 765
      Align = alClient
      Columns = <
        item
          Caption = 'File Name'
          Width = 220
        end
        item
          Caption = 'Folder'
          Width = 300
        end
        item
          Alignment = taRightJustify
          Caption = 'Size'
          Width = 90
        end
        item
          Caption = 'Modified'
          Width = 140
        end>
      GridLines = True
      ReadOnly = True
      RowSelect = True
      TabOrder = 0
